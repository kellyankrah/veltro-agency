# Copy this file to .env.local and fill in your existing Supabase project's
# values (Supabase dashboard -> Project Settings -> API). Never commit
# .env.local or real credentials — it's already in .gitignore.
#
# Only the anon/public key belongs here. Do not put a service-role key in
# any client-side environment variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
